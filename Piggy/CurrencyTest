-- ------------------------------------------------------------
-- 0. SETTINGS & SERVER CHECK
-- ------------------------------------------------------------
if #Players:GetPlayers() > 1 then
    LocalPlayer:Kick("join a private server to use currency farm")
    return
end
Players.PlayerAdded:Connect(function(plr)
    if plr ~= LocalPlayer then
        LocalPlayer:Kick("join a private server to use currency farm")
    end
end)
